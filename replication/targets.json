  "fig_simple_allocation_stackpomdp_mappo_m1": {
    "status": "owned_here",
    "description": "Simple Allocation message-capacity curve with one message (25-seed paper cohort).",
    "figure_or_table": "SA-MessageComparison_1M",
    "module": "stackelberg_pomdp.experiments.simple_allocation",
    "args": {
      "num_messages": 1,
      "max_steps": 5000000,
      "algorithm": "PPO",
      "critic_obs": "full",
      "pomdp_mode": "stackelberg",
      "tot_num_reward_episodes": 30,
      "eval_freq": 5000,
      "eval_episodes": 1,
      "eval_reward_episodes": 30,
      "fix_episode_actions": true,
      "followers_algorithm": "MW",
      "mw_epsilon": 0.1,
      "mw_reset_weights_each_episode": true,
      "ent_coef": 0.01,
      "seed": "{seed}",
      "mw_response_cycles": 33
    },
    "cohort": {
      "seeds": "1-25",
      "plot_max_steps": 1000000,
      "executed_response_games": 33,
      "complete_mw_updates": 33,
      "note": "Prospective shared 33-update protocol; retained curves used different response budgets. See replication/README.md."
    },
