{
  "calvano_m4_calibration": {
    "description": "Calibrate Q-learning sellers on the paper m=4 grid [1.05, 1.7].",
    "figure_or_table": "deviation_m4 calibration input",
    "module": "stackelberg_pomdp.calvano_replication",
    "args": {
      "m": 4,
      "alpha": 0.25,
      "beta": "1e-4",
      "n_sessions": 5,
      "output_dir": "results/calvano_m4"
    }
  },
  "calvano_m4_deviation": {
    "description": "Run the deviation/punishment diagnostic from saved m=4 Q-tables.",
    "figure_or_table": "deviation_m4",
    "module": "stackelberg_pomdp.calvano_deviation",
    "args": {
      "input_dir": "results/calvano_m4"
    }
  },
  "platform_intervention_state": {
    "description": "Train the state-based StackPOMDP threshold intervention.",
    "figure_or_table": "collusion_learning_25seeds",
    "module": "stackelberg_pomdp.main_args",
    "args": {
      "experiment_type": "bertrand",
      "platform_intervention": "learn_threshold",
      "platform_observation_space": "price_profile",
      "price_grid_length": 4,
      "price_min": 1.05,
      "price_max": 1.7,
      "tot_num_eq_episodes": 50000,
      "tot_num_reward_episodes": 30,
      "algorithm": "A2C",
      "max_steps": 50000000,
      "critic_obs": "full",
      "fix_episode_actions": true,
      "followers_algorithm": "Qlearning",
      "seed": "{seed}",
      "learning_method": "RL:Standard",
      "response_phase_prob": 1.0,
      "follower_alpha": 0.25,
      "follower_beta": "1e-4"
    }
  },
  "platform_intervention_no_state": {
    "description": "Train the no-state StackPOMDP threshold intervention.",
    "figure_or_table": "collusion_learning_25seeds",
    "module": "stackelberg_pomdp.main_args",
    "args": {
      "experiment_type": "bertrand",
      "platform_intervention": "learn_threshold",
      "platform_observation_space": "no_observation",
      "price_grid_length": 4,
      "price_min": 1.05,
      "price_max": 1.7,
      "tot_num_eq_episodes": 50000,
      "tot_num_reward_episodes": 30,
      "algorithm": "A2C",
      "max_steps": 50000000,
      "critic_obs": "full",
      "fix_episode_actions": true,
      "followers_algorithm": "Qlearning",
      "seed": "{seed}",
      "learning_method": "RL:Standard",
      "response_phase_prob": 1.0,
      "follower_alpha": 0.25,
      "follower_beta": "1e-4"
    }
  }
}
